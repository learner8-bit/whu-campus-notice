# Copy to .env locally. Never commit .env or paste credentials into source code.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
# Optional when Feishu bot signature verification is enabled:
FEISHU_SECRET=

# Optional: only needed if --channels email or --channels both is enabled.
# Use your mail provider's SMTP host and an app-specific SMTP authorization code.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
